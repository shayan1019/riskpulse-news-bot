RISKPULSE_ENV=dev
RISKPULSE_CONFIG_PATH=config/riskpulse.yaml
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional admin fallback chat when there are no active subscribers.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_COMMAND_POLL_TIMEOUT_SECONDS=45
RISKPULSE_DB_PATH=data/riskpulse.db
RISKPULSE_LOG_LEVEL=INFO
RISKPULSE_TIMEZONE=UTC
TEST_MODE=false
ENABLE_MOCK_BREAKING_FALLBACK=false
ENABLE_MOCK_CALENDAR_FALLBACK=false
ENABLE_MOCK_ANOMALY_ADAPTER=false
NORMAL_MODE_DEDUP_TTL_SECONDS=7200
NORMAL_MODE_EXACT_DUP_RENOTIFY_SECONDS=45
NORMAL_MODE_EXACT_DUP_MAX_SENDS_PER_STORY=1
NORMAL_MODE_NEAR_DUP_SIMILARITY=0.88
NORMAL_MODE_THRESHOLD_PROFILE=balanced
NORMAL_MODE_HARD_EVENT_COOLDOWN_SECONDS=600
NORMAL_MODE_SOFT_THEME_COOLDOWN_SECONDS=180
NORMAL_MODE_ASSET_COOLDOWN_SECONDS=300
NORMAL_MODE_DAILY_PUSH_CAP=25
NORMAL_MODE_DAILY_HIGH_CAP=15
NORMAL_MODE_DAILY_CRITICAL_RESERVE=3
NORMAL_MODE_BREAKING_MAX_AGE_SECONDS=7200
NORMAL_MODE_BACKFILL_SILENT_SECONDS=120
NORMAL_MODE_GDELT_PRIORITY_BOOST_WHEN_NEWSAPI_EMPTY=1
ENABLE_NEWSAPI=true
NEWSAPI_API_KEY=your_newsapi_key_here
NEWSAPI_ENDPOINT=https://newsapi.org/v2/top-headlines
NEWSAPI_QUERY=forex OR gold OR oil OR federal reserve OR geopolitics OR opec
NEWSAPI_LANGUAGE=en
NEWSAPI_PAGE_SIZE=15
NEWSAPI_TIMEOUT_SECONDS=8
NEWSAPI_MAX_RETRIES=1
# Trading Economics disabled (paid source)
MARKETAUX_API_KEY=your_marketaux_key_here
ENABLE_MARKETAUX=true
MARKETAUX_ENDPOINT=https://api.marketaux.com/v1/news/all
MARKETAUX_SEARCH=forex,oil,gold,geopolitics,opec,fed,ecb,boj,boe
MARKETAUX_LANGUAGE=en
MARKETAUX_LIMIT=15
MARKETAUX_TIMEOUT_SECONDS=8
MARKETAUX_MAX_RETRIES=3
MARKETAUX_PLAN_FAILURE_COOLDOWN_SECONDS=1800
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here
ALPHAVANTAGE_ENDPOINT=https://www.alphavantage.co/query
ALPHAVANTAGE_TOPICS=economy_macro,energy_transport,financial_markets,forex,commodities
ALPHAVANTAGE_LIMIT=15
ALPHAVANTAGE_TIMEOUT_SECONDS=8
ALPHAVANTAGE_MAX_RETRIES=3
ENABLE_GDELT=true
GDELT_POLL_EVERY_N_CYCLES=3
GDELT_ENDPOINT=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_QUERY=(gold OR oil OR opec OR fed OR treasury OR yields OR forex OR dollar) sourcelang:english
GDELT_TIMESPAN=6h
GDELT_MAX_RECORDS=10
GDELT_TIMEOUT_SECONDS=15
GDELT_MAX_RETRIES=2
RSS_FEED_URLS=https://investinglive.com/feed/,https://www.fxstreet.com/rss/news,https://www.investing.com/rss/news_1.rss
RSS_TIMEOUT_SECONDS=10
RSS_MAX_RETRIES=2
RSS_MAX_ITEMS=12
